# Claude Code local session artifacts (settings.local.json, session state, caches).
# Deliberate, committed agent configuration is exempt — see .claude/README.md. The pattern must be
# `.claude/*` rather than `.claude/`: with a trailing slash git never descends into the directory,
# so the negations below would not apply and the config could not be tracked at all.
.claude/*
!.claude/README.md
!.claude/advisors/
!.claude/agents/
!.claude/skills/

# Unity
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
*.pidb
*.suo
*.user
*.userprefs
*.unityproj
*.booproj
.vs/

# Unity-project junction into src/ (created locally per clone; never committed —
# it is a link, and committing it would double-track the whole src/ tree)
/Assets/Scripts
/Assets/Scripts.meta

# OS
.DS_Store
Thumbs.db

# Dotnet CI gate (tools/dotnet-ci) — generated, never committed
*.gen.csproj
*.gen.sln
[Bb]in/

# Unity IDE project files (regenerated by com.unity.ide.visualstudio / com.unity.ide.rider)
*.csproj
*.sln
.vsconfig
