# Claude Code session artifacts. Ignore everything under .claude/ by default —
# shell snapshots, caches and per-machine history live here — then re-include
# only the two things that are shared, reviewable project config.
.claude/*
!.claude/skills/
!.claude/settings.json
# Personal overrides always stay local, even though settings.json is tracked.
.claude/settings.local.json

# Unity
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
*.pidb
*.suo
*.user
*.userprefs
*.unityproj
*.booproj
.vs/

# Unity-project junction into src/ (created locally per clone; never committed —
# it is a link, and committing it would double-track the whole src/ tree)
/Assets/Scripts
/Assets/Scripts.meta

# OS
.DS_Store
Thumbs.db

# Dotnet CI gate (tools/dotnet-ci) — generated, never committed
*.gen.csproj
*.gen.sln
[Bb]in/

# Unity IDE project files (regenerated by com.unity.ide.visualstudio / com.unity.ide.rider)
*.csproj
*.sln
.vsconfig
