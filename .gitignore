# Claude Code session artifacts
.claude/
# ...except shared, reviewable project skills. Local/per-machine state
# (settings.local.json, caches, shell snapshots) stays ignored by the rule above.
!.claude/
!.claude/skills/
!.claude/skills/**
.claude/settings.local.json

# Unity
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
*.pidb
*.suo
*.user
*.userprefs
*.unityproj
*.booproj
.vs/

# Unity-project junction into src/ (created locally per clone; never committed —
# it is a link, and committing it would double-track the whole src/ tree)
/Assets/Scripts
/Assets/Scripts.meta

# OS
.DS_Store
Thumbs.db

# Dotnet CI gate (tools/dotnet-ci) — generated, never committed
*.gen.csproj
*.gen.sln
[Bb]in/

# Unity IDE project files (regenerated by com.unity.ide.visualstudio / com.unity.ide.rider)
*.csproj
*.sln
.vsconfig
