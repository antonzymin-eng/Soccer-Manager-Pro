# Claude Code session artifacts — local settings and transcripts stay out, but
# .claude/skills/ is versioned: project skills encode this repo's conventions and
# must travel with the code that defines them. (Written as `.claude/*` + a negation
# because git cannot re-include a path under an excluded directory.)
.claude/*
!.claude/skills/

# Unity
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
*.pidb
*.suo
*.user
*.userprefs
*.unityproj
*.booproj
.vs/

# Unity-project junction into src/ (created locally per clone; never committed —
# it is a link, and committing it would double-track the whole src/ tree)
/Assets/Scripts
/Assets/Scripts.meta

# OS
.DS_Store
Thumbs.db

# Dotnet CI gate (tools/dotnet-ci) — generated, never committed
*.gen.csproj
*.gen.sln
[Bb]in/

# Unity IDE project files (regenerated by com.unity.ide.visualstudio / com.unity.ide.rider)
*.csproj
*.sln
.vsconfig
