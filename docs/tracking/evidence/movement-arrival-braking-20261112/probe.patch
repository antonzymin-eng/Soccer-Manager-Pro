@@ -0,0 +1,37 @@
+using System;
+using NUnit.Framework;
+using UnityEngine;
+using TacticalDirector.PositioningAI;
+namespace TacticalDirector.DefensiveAI.Tests
+{
+    public sealed class MovementArrivalStaleTackleProbe
+    {
+        [TestCase(0)] [TestCase(1)]
+        public void DemotedDuplicateRetainsCommitIntent(int team)
+        {
+            var agents = new[] {
+                SnapshotBuilder.MakeAgent(17, team, new Vector2(38,34), new Vector2(1,0), line:LineId.Midfield, baselineSlot:new Vector2(38,34)),
+                SnapshotBuilder.MakeAgent(18, team, new Vector2(39,34), new Vector2(1,0), line:LineId.Midfield, baselineSlot:new Vector2(39,34)),
+                SnapshotBuilder.MakeAgent(19, team, new Vector2(10,34), line:LineId.Midfield, baselineSlot:new Vector2(10,34)),
+                SnapshotBuilder.MakeAgent(20, team, new Vector2(15,34), line:LineId.Midfield, baselineSlot:new Vector2(15,34)),
+                SnapshotBuilder.MakeAgent(100, 1-team, new Vector2(40,34), line:LineId.Midfield)
+            };
+            var snap = SnapshotBuilder.Build(agents, ballPosition:new Vector2(40,34));
+            snap.DefensiveTeamId=team; snap.MarkMovementActive=true;
+            var ai=new DefensiveAITick(100);
+            int stale=0;
+            for(int tick=0;tick<12;tick++)
+            {
+                snap.TickIndex=tick; ai.Tick(snap);
+                foreach(var req in ai.GetTackleIntentRequests())
+                {
+                    var final=ai.GetAssignment(req.AgentEntityId);
+                    Console.WriteLine($"STALE team={team} tick={tick} agent={req.AgentEntityId} request={req.Mode} target={req.TargetEntityId} finalMode={final.Mode} finalTarget={final.TargetEntityId}");
+                    if(final.Mode==MarkMode.Zonal && req.Mode==TackleMode.Commit && req.TargetEntityId==100) stale++;
+                }
+            }
+            Assert.Greater(stale,0,"Diagnostic: reproduce stale COMMIT requests after demotion; this is not a fix-acceptance test.");
+            Console.WriteLine($"STALE_RESULT team={team} stale_commit_requests={stale}");
+        }
+    }
+}
