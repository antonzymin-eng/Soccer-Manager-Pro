+        {
+            const ulong seed = 0x441UL;
+            var engine = new MatchEngine(seed);
+            engine.EnableGkHeading();
+            int agent = -1;
+            for (int i = 0; i < MatchEngineConstants.SQUAD_SIZE; i++)
