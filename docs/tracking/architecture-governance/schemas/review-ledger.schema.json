{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Architecture Governance Review Ledger v1",
  "type": "object",
  "required": ["schema_version", "legacy_policy", "review_runs", "findings"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "legacy_policy": { "const": "read-only-no-inference" },
    "review_runs": {
      "type": "array",
      "items": { "$ref": "#/$defs/reviewRun" }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "reviewRun": {
      "type": "object",
      "required": [
        "review_run_id", "review_series_id", "review_scope", "subject_scope_digest",
        "review_round", "reviewer_identity", "coverage", "unverified_surfaces",
        "applicable_properties", "convergence_state", "final_review",
        "round_budget_exhausted"
      ],
      "properties": {
        "review_run_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "review_series_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "review_scope": { "$ref": "common.schema.json#/$defs/stringList", "minItems": 1 },
        "subject_scope_digest": { "$ref": "common.schema.json#/$defs/sha256" },
        "provenance_revision": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "provenance_tree": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "review_round": { "type": "integer", "minimum": 1 },
        "reviewer_identity": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "coverage": { "$ref": "common.schema.json#/$defs/stringList", "minItems": 1 },
        "unverified_surfaces": { "$ref": "common.schema.json#/$defs/stringList" },
        "applicable_properties": {
          "type": "array",
          "items": { "$ref": "#/$defs/propertyResult" }
        },
        "convergence_state": { "$ref": "common.schema.json#/$defs/reviewState" },
        "final_review": { "type": "boolean" },
        "round_budget_exhausted": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "propertyResult": {
      "type": "object",
      "required": ["property_id", "result", "evidence_refs"],
      "properties": {
        "property_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "result": { "$ref": "common.schema.json#/$defs/propertyResult" },
        "evidence_refs": { "$ref": "common.schema.json#/$defs/stringList" },
        "approval_ref": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
      },
      "allOf": [
        {
          "if": { "properties": { "result": { "const": "na" } } },
          "then": { "required": ["approval_ref"] },
          "else": { "not": { "required": ["approval_ref"] } }
        },
        {
          "if": { "properties": { "result": { "const": "pass" } } },
          "then": { "properties": { "evidence_refs": { "minItems": 1 } } }
        }
      ],
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": [
        "finding_id", "stable_key", "review_series_id", "parent_review_run_id",
        "summary", "evidence", "severity", "requirement_property", "disposition",
        "required_action", "owner", "status", "round_introduced",
        "resolution_evidence", "status_history"
      ],
      "properties": {
        "finding_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "stable_key": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "review_series_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "parent_review_run_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "summary": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "evidence": { "$ref": "common.schema.json#/$defs/stringList", "minItems": 1 },
        "severity": { "$ref": "common.schema.json#/$defs/severity" },
        "requirement_property": { "$ref": "common.schema.json#/$defs/stringList" },
        "disposition": { "$ref": "common.schema.json#/$defs/disposition" },
        "required_action": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "owner": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "status": { "$ref": "common.schema.json#/$defs/findingStatus" },
        "round_introduced": { "type": "integer", "minimum": 1 },
        "resolution_evidence": { "$ref": "common.schema.json#/$defs/stringList" },
        "status_history": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/statusEvent" }
        },
        "disposition_approval": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "resolution_property_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "statusEvent": {
      "type": "object",
      "required": ["event_id", "transition_from", "transition_to", "actor", "at", "evidence"],
      "properties": {
        "event_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "transition_from": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "common.schema.json#/$defs/findingStatus" }
          ]
        },
        "transition_to": { "$ref": "common.schema.json#/$defs/findingStatus" },
        "actor": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "at": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "evidence": { "$ref": "common.schema.json#/$defs/stringList" },
        "approval_ref": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    }
  }
}
