{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tactical-director.internal/architecture-governance/runtime-surface-classifications.schema.json",
  "title": "Runtime Surface Classification Intent v1",
  "type": "object",
  "required": ["schema_version", "surfaces"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "surface_id", "symbol_key", "kind", "source_path", "signature",
          "assembly", "classification"
        ],
        "properties": {
          "surface_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "symbol_key": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "kind": { "$ref": "common.schema.json#/$defs/selectorKind" },
          "source_path": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "signature": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "assembly": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "classification": { "$ref": "common.schema.json#/$defs/structuralClassification" },
          "component_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "contract_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
